<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. The Supabase session (default shared prefs,
     written by multiplatform-settings) stays on the device: restoring it to
     another phone would carry over a live refresh token. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.nexal.app_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.nexal.app_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
