<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The bitmap includes Android's adaptive-icon safe padding so the
         complete athlete remains visible under circle and squircle masks. -->
    <item>
        <bitmap
            android:antialias="true"
            android:filter="true"
            android:gravity="fill"
            android:src="@drawable/ic_launcher_athlete" />
    </item>
</layer-list>
